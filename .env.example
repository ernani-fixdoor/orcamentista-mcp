# Chave secreta que faz parte da URL do conector: https://<projeto>.vercel.app/<MCP_CHAVE>/mcp
MCP_CHAVE=

# RD Station CRM: token da API (Perfil > Token da instância / Integrações)
RD_CRM_TOKEN=

# Supabase "fixdoor-sistemas": URL + chave PUBLICÁVEL (sb_publishable_...). Não precisa da service key:
# o conector só chama as funções public.orc_*, que exigem a ORC_DB_CHAVE (hash em orcamentista.config).
SUPABASE_URL=https://emoptjbvfcnaeeeeuxbq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ORC_DB_CHAVE=

# RD Station API v2 (anexos): app OAuth do RD App Publisher
RD_CLIENT_ID=
RD_CLIENT_SECRET=

# Omie (omie_anexar_arquivo): Omie > Configurações > Chaves de API. Uma chave por empresa. Nunca a Fast & Safe.
OMIE_FIXDOOR_APP_KEY=
OMIE_FIXDOOR_APP_SECRET=
OMIE_MAXDOCK_APP_KEY=
OMIE_MAXDOCK_APP_SECRET=
