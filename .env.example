# Chave secreta que faz parte da URL do conector: https://<projeto>.vercel.app/<MCP_CHAVE>/mcp
# Gere uma longa e aleatória (ex.: openssl rand -hex 24). Quem tiver a URL usa o conector.
MCP_CHAVE=

# RD Station CRM: token da API (Perfil > Token da instância / Integrações)
RD_CRM_TOKEN=

# Supabase compartilhado "fixdoor-sistemas" (mesma URL e chave secreta da tabela de preços)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
